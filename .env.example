# Базовый URL проекта Supabase, без /rest/v1
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
# Publishable (ex-anon) ключ. Публичен по дизайну: защита строится на RLS, а не на его секретности
VITE_SUPABASE_ANON_KEY=sb_publishable_...

# --- только для локальных скриптов, НИКОГДА не попадает во фронтенд и в репозиторий ---
# Secret (ex-service_role) ключ: нужен scripts/seed.mjs для создания тестовых пользователей
SUPABASE_SERVICE_ROLE_KEY=sb_secret_...
# Пароль БД: нужен supabase CLI для push миграций
SUPABASE_DB_PASSWORD=...
